# region other

source $HOME/.config/zsh/path.zsh

# ADR-0009
export NPM_CONFIG_PREFIX="$HOME/.npm-global"

HISTFILE=~/.zsh_history
HISTSIZE=10000
SAVEHIST=10000
setopt appendhistory

# Must run after PATH is set and before compinit (puts completions dir on fpath)
source $HOME/.config/zsh/completions.zsh
# endregion

# region zi
source "$HOME/.zi/bin/zi.zsh"
zi light zsh-users/zsh-autosuggestions
zi light zsh-users/zsh-syntax-highlighting
zi light unixorn/fzf-zsh-plugin

# endregion

# region compinit
autoload -Uz _zi
(( ${+_comps} )) && _comps[zi]=_zi
zicompinit
comp-source

# endregion

eval "$(starship init zsh)"

# region aliases
alias vim="vim"
alias vi="vim"
alias oldvim="vim"
export EDITOR=/bin/vim
alias git-github="git config --global user.name leitosama;git config --global user.email fs.leito@gmail.com"
# Markdown reader (ADR-0010): glow when installed (cli.yaml), else just highlighted.
# No args: glow's file browser, or stdin when piped (`curl … | md`)
md() {
  if (( $+commands[glow] )); then
    if (( $# )); then glow -p "$@"
    elif [[ -t 0 ]]; then glow
    else glow -p -
    fi
  elif (( $+commands[bat] )); then bat -l md "$@"
  elif (( $+commands[batcat] )); then batcat -l md "$@"
  else less "$@"
  fi
}
alias lessh='LESSOPEN="| /usr/bin/src-hilite-lesspipe.sh %s" less -M '

bindkey "^[[1;5C" forward-word
bindkey "^[[1;5D" backward-word

# endregion
